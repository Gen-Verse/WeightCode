# Copy to scripts/env.sh, replace the paths, then source scripts/env.sh.
# scripts/env.sh is local-only. Each variable must name an existing directory.
export WEIGHTCODE_PRIVATE=/path/to/weightcode_store/private   # train/val data, split indices, students, instances
export WEIGHTCODE_SEALED=/path/to/weightcode_store/sealed     # official test sets and sealed evaluator state (never opened in dev)
export WEIGHTCODE_RUNS=/path/to/weightcode_store/runs         # sessions, readouts and every other run record
